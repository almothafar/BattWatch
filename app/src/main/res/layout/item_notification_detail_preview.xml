<?xml version="1.0" encoding="utf-8"?>
<!-- The top of the notification-details picker (#358): the status notification as the chosen rows make it, live, the title and the line they make in their
     order. Outlined so it reads as a picture of something else rather than one more card of settings. It wraps where the shade would cut the line short,
     because how much fits there depends on the device rather than on this screen's width. Framed, so the card hidden for want of a battery reading takes the
     item's height with it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/notification_details_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/settings_card_horizontal_margin"
        android:layout_marginTop="@dimen/settings_card_group_gap"
        android:layout_marginEnd="@dimen/settings_card_horizontal_margin"
        app:cardBackgroundColor="@color/settings_group_card"
        app:cardCornerRadius="@dimen/settings_card_corner_radius"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="?android:attr/listPreferredItemPaddingStart"
            android:paddingTop="12dp"
            android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/notification_details_preview_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/notification_details_preview_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
