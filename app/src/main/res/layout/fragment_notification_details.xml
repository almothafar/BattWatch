<?xml version="1.0" encoding="utf-8"?>
<!-- The notification-details picker (#357). Same card-on-neutral look as the preference screens (PreferenceCardDecoration), built from views because the
     reorder slice (#358) drags these rows, which a preference list cannot do. Overdraw is accepted, not fixed: every preference screen paints this same
     backdrop over the window background, from code, and this one has to match them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_group_background"
    android:orientation="vertical"
    tools:ignore="Overdraw">

    <!-- Inset as the rows below are, card margin plus list-item padding, so the text lines up with theirs on any screen: the padding is wider on tablets
         and unfolded foldables than on phones. -->
    <TextView
        android:id="@+id/notification_details_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/settings_card_horizontal_margin"
        android:layout_marginEnd="@dimen/settings_card_horizontal_margin"
        android:accessibilityLiveRegion="polite"
        android:paddingStart="?android:attr/listPreferredItemPaddingStart"
        android:paddingTop="@dimen/settings_card_group_gap"
        android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
        android:paddingBottom="8dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/settings_card_horizontal_margin"
        android:layout_marginEnd="@dimen/settings_card_horizontal_margin"
        android:layout_marginBottom="@dimen/settings_card_group_gap"
        app:cardBackgroundColor="@color/settings_group_card"
        app:cardCornerRadius="@dimen/settings_card_corner_radius"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/notification_details_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
