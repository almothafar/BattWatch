<?xml version="1.0" encoding="utf-8"?>
<!-- The notification-details picker (#357, #358): one list from top to bottom, the preview, the header, then a row per family on a card. The page scrolls as
     one list, so a row dragged to the screen's edge scrolls it along: ItemTouchHelper only ever scrolls the list it drags in. Same card-on-neutral look as the
     preference screens (PreferenceCardDecoration), painted behind the rows by RowCardDecoration. Overdraw is accepted, not fixed: every preference screen
     paints this same backdrop over the window background, from code, and this one has to match them. -->
<androidx.recyclerview.widget.RecyclerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notification_details_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_group_background"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/settings_card_group_gap"
    tools:ignore="Overdraw" />
