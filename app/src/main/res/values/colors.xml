<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material Design 3 Color System. Dark values live in values-night/colors.xml (#225). -->
    <color name="md_theme_primary">#059bbf</color>
    <color name="md_theme_onPrimary">#FFFFFF</color>
    <color name="md_theme_primaryContainer">#32BEA6</color>
    <color name="md_theme_secondary">#004A5B</color>
    <color name="md_theme_onSecondary">#FFFFFF</color>
    <color name="md_theme_surface">#FFFFFF</color>
    <color name="md_theme_onSurface">#000000</color>
    <color name="md_theme_background">#FFFBFF</color>
    <color name="md_theme_onBackground">#1C1B1E</color>
    <color name="md_theme_error">#BA1A1A</color>
    <color name="md_theme_onError">#FFFFFF</color>

    <!-- The accent for a snackbar, which Material paints on an inverted surface: here a dark #322F35 slab, so this is the light end of the brand
         rather than the dark one. Undefined it falls back to M3's lavender #D0BCFF, which is what the theme snackbar showed until #333. -->
    <color name="md_theme_primaryInverse">#6ED3EC</color>

    <!-- Gauge and brand-header fills. These are large areas of colour, so they deepen for dark rather than staying
         put (see values-night/colors.xml); the gauge palette that sits on them is re-tuned to match. -->
    <color name="circular_progress_default_progress">#059bbf</color>
    <color name="circular_progress_default_progress_warning">#FFB100</color>
    <color name="circular_progress_default_progress_alert">#E01A00</color>
    <color name="circular_progress_default_background">#023e4c</color>
    <color name="circular_progress_default_title">#FFD26A</color>
    <color name="circular_progress_default_subtitle">#FFFFFF</color>
    <color name="top_background_color">#32BEA6</color>
    <color name="title_bar_background_color">#059bbf</color>

    <!-- The same two brand hues used as accent text on a page rather than as a large fill (the health grades, the
         signature links). Split from the fills above because dark mode pulls them in opposite directions: the fills
         darken, accents lighten. Identical values here, so light mode is unchanged. -->
    <color name="accent_teal">#32BEA6</color>
    <color name="accent_blue">#059bbf</color>

    <!-- Details-table and insight-card text. Sits on the page, not the header, so it inverts for dark. -->
    <color name="battery_details_label_color">#004A5B</color>
    <color name="battery_details_value_color">#01708A</color>
    <color name="default_text_color">#004A5B</color>

    <!-- The on-surface twins of the gauge's warning/alert hues: the same signal drawn as text on a page
         background rather than as an arc on the coloured header — drain rate in the details table (#108)
         and the critical/warning threshold captions. Both pairs happen to hold the same values today, in both
         modes, but they answer to different backdrops: separating them lets a page-contrast fix move on its own
         (#225 lifted the red to a coral for 4.5:1 on a dark surface) without dragging the arc with it. -->
    <color name="battery_rate_warn">#FFB100</color>
    <color name="battery_rate_high">#E01A00</color>

    <!-- Settings "card group" style (#222): a subtle neutral behind the preference list so the white
         grouped cards stand out, Material-You style. -->
    <color name="settings_group_background">#F0F1F4</color>
    <color name="settings_group_card">#FFFFFF</color>
</resources>
