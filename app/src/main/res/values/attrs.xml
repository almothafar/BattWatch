<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="HorseshoeProgressBar">
        <attr name="gaugeStrokeWidth" format="dimension"/>
        <attr name="gaugeTrackColor" format="color"/>
        <attr name="gaugeLevelColor" format="color"/>
        <attr name="gaugeWarningColor" format="color"/>
        <attr name="gaugeAlertColor" format="color"/>
        <attr name="gaugeTitle" format="string"/>
        <attr name="gaugeTitleColor" format="color"/>
        <attr name="gaugeTitleTextSize" format="dimension"/>
        <attr name="gaugeStatusText" format="string"/>
        <attr name="gaugeStatusColor" format="color"/>
        <attr name="gaugeStatusTextSize" format="dimension"/>
        <attr name="gaugeShowShadow" format="boolean"/>
        <!-- Screen-reader template for the current level, e.g. "Battery at %1$s percent". Takes the level as its single argument, and is written with %1$s:
             that is the catalogue's rule (#273), and StringResourceDigitsTest enforces it on the string resources and the style items where this attribute is
             actually set. A %1$d template still formats correctly at runtime, since announceLevel uses Locale.ROOT and the digits stay Western either way —
             that is tolerance for templates written before the rule, not a second spelling to pick from. -->
        <attr name="gaugeLevelDescription" format="string"/>
    </declare-styleable>

    <declare-styleable name="RingtonePreference">
        <!-- The alerts this picker's severity bucket drives, e.g. "Critical battery, overheating" (#307). Appended to the selected sound's name in the
             summary, because one picker sets the sound for two or three channels and the row alone cannot say which. -->
        <attr name="bucketSummary" format="string"/>
    </declare-styleable>

    <declare-styleable name="MinMaxRangeView">
        <!-- Size of the two value cells; the "min"/"max" captions above them are fixed -->
        <attr name="rangeValueTextSize" format="dimension"/>
        <!-- Whether the values are the card's primary figure, and so shown bold -->
        <attr name="rangeValueBold" format="boolean"/>
    </declare-styleable>

    <declare-styleable name="BatteryRangeSliderPreference">
        <!-- SharedPreferences keys the two thumbs persist to -->
        <attr name="criticalKey" format="string"/>
        <attr name="warningKey" format="string"/>
        <!-- Combined track bounds and the minimum gap kept between the two thumbs -->
        <attr name="sliderFrom" format="integer"/>
        <attr name="sliderTo" format="integer"/>
        <attr name="sliderMinSeparation" format="integer"/>
        <attr name="criticalDefault" format="integer"/>
        <attr name="warningDefault" format="integer"/>
    </declare-styleable>
</resources>