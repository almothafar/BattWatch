        android:rotation="90"
        android:pivotX="480"
        android:pivotY="-480">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M200-280q-17 0-28.5-11.5T160-320v-80H80v-160h80v-80q0-17 11.5-28.5T200-680h640q17 0 28.5 11.5T880-640v320q0 17-11.5 28.5T840-280H200Zm40-80h440v-240H240v240Z" />
    </group>
