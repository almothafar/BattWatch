<!-- The "Alerts" screen (#112): WHAT to be notified about. One category per alert event, in
     battery-lifecycle order (levels → warning → critical → full → temperature → drain → charging).
     Cross-cutting delivery options (sound in silent mode, vibration, quiet hours, stickiness)
     and the charge-announcement style live on the "Notification behaviour" screen
     (pref_behaviour.xml). -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- The slider configures the warning + critical alerts directly below it -->
    <PreferenceCategory
        android:title="@string/pref_cat_title_thresholds"
        app:iconSpaceReserved="false">

        <!-- criticalDefault/warningDefault must match AppPrefs.DEFAULT_CRITICAL_LEVEL /
             DEFAULT_WARNING_LEVEL, the single owner of these defaults for the alert engine,
             receiver and gauge (#162). The framework instantiates from XML, so the value is
             restated here rather than shared as a constant. -->
        <com.almothafar.simplebatterynotifier.ui.preference.BatteryRangeSliderPreference
            android:key="@string/_pref_key_battery_level_range"
            android:persistent="false"
            app:criticalKey="@string/_pref_key_critical_battery_level"
            app:warningKey="@string/_pref_key_warn_battery_level"
            app:sliderFrom="10"
            app:sliderTo="50"
            app:sliderMinSeparation="5"
            app:criticalDefault="20"
            app:warningDefault="40"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_cat_title_warning"
        app:iconSpaceReserved="false">

        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/_pref_key_notify_for_warning_level"
            android:summaryOff="@string/notify_for_warning_level_summary_off"
            android:summaryOn="@string/notify_for_warning_level_summary_on"
            android:switchTextOff="@string/off"
            android:switchTextOn="@string/on"
            android:title="@string/notify_for_warning_level"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_cat_title_critical"
        app:iconSpaceReserved="false">

        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/_pref_key_notify_every_tick"
            android:summaryOff="@string/notify_every_tick_summary_off"
            android:summaryOn="@string/notify_every_tick_summary_on"
            android:switchTextOff="@string/off"
            android:switchTextOn="@string/on"
            android:title="@string/notify_every_tick"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_cat_title_full_battery"
        app:iconSpaceReserved="false">

        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/_pref_key_notify_for_full_level"
            android:summaryOff="@string/notify_for_full_level_summary_off"
            android:summaryOn="@string/notify_for_full_level_summary_on"
            android:switchTextOff="@string/off"
            android:switchTextOn="@string/on"
            android:title="@string/notify_for_full_level"
            app:iconSpaceReserved="false" />

        <!-- #263: the level the alert fires at while charging. defaultValue/min/max must match
             AppPrefs.DEFAULT/MIN/MAX_CHARGE_TARGET, which clamp the stored value when it is read;
             AppPrefsTest guards the pair against drift by inflating this preference — note the
             minimum is app:min, since androidx SeekBarPreference reads `min` from its own namespace
             and ignores android:min entirely. At the maximum the alert waits for a completed charge,
             which is what the app did before this slider existed. This slider's summary and the
             switch title above it are set from the value in GenericPreferenceFragment: below a full
             charge the alert is about being almost full.

             Deliberately NOT gated by the alert switch above (the same call the drain limit makes
             below, for the same reason): the target also defines "this charge is done" for the
             Insights temperature range (#260), so switching the alert off must not lock a control
             that still governs a feature the user did not disable. -->
        <SeekBarPreference
            android:defaultValue="90"
            android:key="@string/_pref_key_charge_target"
            app:min="80"
            android:max="100"
            android:title="@string/charge_target"
            style="@style/PreferenceSeekBar"
            app:showSeekBarValue="true"
            app:adjustable="true"
            app:iconSpaceReserved="false" />

        <!-- #264: the opt-in repeat. Off by default — the alert is once per charge unless the user asks to be
             nagged, because a notification that keeps coming back is a nag for everyone who didn't.

             Gated by the alert switch above, unlike the charge target: there is nothing to repeat when the
             alert itself is off, and this preference governs nothing else. The interval in turn depends on
             this switch, so the whole reminder collapses with it. -->
        <SwitchPreference
            android:defaultValue="false"
            android:dependency="@string/_pref_key_notify_for_full_level"
            android:key="@string/_pref_key_notify_unplug_reminder"
            android:summaryOff="@string/notify_unplug_reminder_summary_off"
            android:summaryOn="@string/notify_unplug_reminder_summary_on"
            android:switchTextOff="@string/off"
            android:switchTextOn="@string/on"
            android:title="@string/notify_unplug_reminder"
            app:iconSpaceReserved="false" />

        <!-- defaultValue/min/max must match AppPrefs.DEFAULT/MIN/MAX_UNPLUG_REMINDER_MINUTES, which clamp the
             stored value when it is read. app:min for the same reason as the sliders above — androidx
             SeekBarPreference reads `min` from its own namespace and ignores android:min entirely. -->
        <SeekBarPreference
            android:defaultValue="15"
            android:dependency="@string/_pref_key_notify_unplug_reminder"
            android:key="@string/_pref_key_unplug_reminder_minutes"
            app:min="5"
            android:max="60"
            android:title="@string/unplug_reminder_minutes"
            style="@style/PreferenceSeekBar"
            app:showSeekBarValue="true"
            app:adjustable="true"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_cat_title_temperature"
        app:iconSpaceReserved="false">

        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/_pref_key_notify_high_temperature"
            android:summaryOff="@string/notify_high_temperature_summary_off"
            android:summaryOn="@string/notify_high_temperature_summary_on"
            android:switchTextOff="@string/off"
            android:switchTextOn="@string/on"
            android:title="@string/notify_high_temperature"
            app:iconSpaceReserved="false" />

        <!-- configureTemperatureThreshold() overrides both bounds at runtime (they shift when the user
             displays °F), so these are the pre-configuration values only. Still app:min, not
             android:min — the latter is silently ignored and would read as working. -->
        <SeekBarPreference
            android:defaultValue="45"
            android:dependency="@string/_pref_key_notify_high_temperature"
            android:key="@string/_pref_key_high_temperature_threshold"
            app:min="40"
            android:max="60"
            android:title="@string/high_temperature_threshold"
            style="@style/PreferenceSeekBar"
            app:showSeekBarValue="true"
            app:adjustable="true"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_cat_title_drain"
        app:iconSpaceReserved="false">

        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/_pref_key_notify_fast_drain"
            android:summaryOff="@string/notify_fast_drain_summary_off"
            android:summaryOn="@string/notify_fast_drain_summary_on"
            android:switchTextOff="@string/off"
            android:switchTextOn="@string/on"
            android:title="@string/notify_fast_drain"
            app:iconSpaceReserved="false" />

        <!-- Shared with #108's table colouring, so it is NOT gated by the alert toggle above.
             defaultValue/min/max must match AppPrefs.DEFAULT/MIN/MAX_DRAIN_LIMIT_PPH,
             which clamp the stored value when it is read (#108/#109).
             app:min, not android:min — androidx SeekBarPreference reads `min` from its own namespace,
             so android:min is silently ignored and the slider bottoms out at 0. -->
        <SeekBarPreference
            android:defaultValue="20"
            android:key="@string/_pref_key_fast_drain_limit"
            app:min="5"
            android:max="60"
            android:summary="@string/drain_limit_summary"
            android:title="@string/drain_limit"
            style="@style/PreferenceSeekBar"
            app:showSeekBarValue="true"
            app:adjustable="true"
            app:iconSpaceReserved="false" />

        <!-- defaultValue/min/max of both timing sliders must match AppPrefs'
             DEFAULT/MIN/MAX_FAST_DRAIN_SUSTAINED_MINUTES and DEFAULT/MIN/MAX_FAST_DRAIN_REMINDER_MINUTES,
             which clamp the stored values when they are read (#109). app:min for the same reason as above. -->
        <SeekBarPreference
            android:defaultValue="5"
            android:dependency="@string/_pref_key_notify_fast_drain"
            android:key="@string/_pref_key_fast_drain_sustained_minutes"
            app:min="1"
            android:max="30"
            android:title="@string/fast_drain_sustained_minutes"
            style="@style/PreferenceSeekBar"
            app:showSeekBarValue="true"
            app:adjustable="true"
            app:iconSpaceReserved="false" />

        <SeekBarPreference
            android:defaultValue="15"
            android:dependency="@string/_pref_key_notify_fast_drain"
            android:key="@string/_pref_key_fast_drain_reminder_minutes"
            app:min="5"
            android:max="60"
            android:title="@string/fast_drain_reminder_minutes"
            style="@style/PreferenceSeekBar"
            app:showSeekBarValue="true"
            app:adjustable="true"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <!-- Charging alerts: the #123 slow-charge warning. The charge-announcement style picker moved to
         Notification behaviour › Appearance (#112 follow-up) — "style" reads as appearance, and that's
         where users look for it. -->
    <PreferenceCategory
        android:title="@string/pref_cat_title_charging"
        app:iconSpaceReserved="false">

        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/_pref_key_notify_slow_charge"
            android:summaryOff="@string/notify_slow_charge_summary_off"
            android:summaryOn="@string/notify_slow_charge_summary_on"
            android:switchTextOff="@string/off"
            android:switchTextOn="@string/on"
            android:title="@string/notify_slow_charge"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

</PreferenceScreen>
