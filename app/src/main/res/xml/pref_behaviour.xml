<!-- The "Notification behaviour" screen (#112): HOW alerts sound and appear, and WHEN they are
     allowed. The per-event settings — which alerts fire, and their thresholds — live on the
     "Alerts" screen (pref_alerts.xml). Sounds used to as well, and moved here in #307: a picker
     sets a whole severity bucket rather than one alert, which is this screen's level, not that one's.

     Appearance leads (#265): its two settings are the ones users change and then verify right
     away, while sound and quiet hours are set once and forgotten. Below the four-row Quiet Hours
     block it fell off-screen on shorter devices. Alert Sounds sits above Sound & Vibration for the
     same reason — it is the block most likely to be looked for, and Quiet Hours stays last. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/pref_cat_title_appearance"
        app:iconSpaceReserved="false">

        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/_pref_key_notifications_sticky"
            android:summaryOff="@string/notification_is_not_sticky"
            android:summaryOn="@string/notification_is_sticky"
            android:switchTextOff="@string/off"
            android:switchTextOn="@string/on"
            android:title="@string/sticky_notification"
            app:iconSpaceReserved="false" />

        <!-- How the charge-connected announcement surfaces (toast / notification / none).
             Moved here from the Alerts screen: "style" reads as appearance, so this is where
             users look for it (#112 follow-up, maintainer decision). -->
        <ListPreference
            android:defaultValue="@string/_pref_value_charge_notification_style_toast"
            android:entries="@array/charge_notification_style_entries"
            android:entryValues="@array/charge_notification_style_values"
            android:key="@string/_pref_key_charge_notification_style"
            android:title="@string/charge_notification_style_title"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <!-- The three per-severity sound pickers (#307). They live here rather than on the Alerts screen because each one
         drives a whole severity bucket rather than the single alert it used to sit under: the critical picker also sets
         the overheat sound, and the warning picker also sets fast-drain and slow-charge. Under a per-event category that
         scope was invisible, so each carries a summary naming every alert it drives.

         Their own category rather than joining Sound & Vibration below: these three are per-severity, while mute-in-
         silent-mode and vibrate apply to every alert. One category holding both reintroduces the same scope confusion.

         The warning and default pickers dropped the android:dependency they carried on the Alerts screen. It could not
         survive the move (a dependency only resolves inside one hierarchy, and the toggles stayed behind), and it was
         already wrong: switching off the low-battery alert greyed out the sound fast-drain and slow-charge still use. -->
    <PreferenceCategory
        android:title="@string/pref_cat_title_alert_sounds"
        app:iconSpaceReserved="false">

        <com.almothafar.simplebatterynotifier.ui.preference.RingtonePreference
            android:defaultValue="content://settings/system/notification_sound"
            android:key="@string/_pref_key_notifications_alert_sound_ringtone"
            android:ringtoneType="notification"
            android:title="@string/notifications_alert_sound_ringtone"
            app:iconSpaceReserved="false"
            app:bucketSummary="@string/notifications_critical_sound_bucket" />

        <com.almothafar.simplebatterynotifier.ui.preference.RingtonePreference
            android:defaultValue="content://settings/system/notification_sound"
            android:key="@string/_pref_key_notifications_warning_sound_ringtone"
            android:ringtoneType="notification"
            android:title="@string/notifications_warning_sound_ringtone"
            app:iconSpaceReserved="false"
            app:bucketSummary="@string/notifications_warning_sound_bucket" />

        <com.almothafar.simplebatterynotifier.ui.preference.RingtonePreference
            android:defaultValue="content://settings/system/notification_sound"
            android:key="@string/_pref_key_notifications_full_sound_ringtone"
            android:ringtoneType="notification"
            android:title="@string/notifications_default_sound_ringtone"
            app:iconSpaceReserved="false"
            app:bucketSummary="@string/notifications_default_sound_bucket" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_cat_title_sound_vibration"
        app:iconSpaceReserved="false">

        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/_pref_key_notifications_apply_silent_mode"
            android:summaryOff="@string/mute_alerts_in_silent_mode_summary_off"
            android:summaryOn="@string/mute_alerts_in_silent_mode_summary_on"
            android:switchTextOff="@string/off"
            android:switchTextOn="@string/on"
            android:title="@string/mute_alerts_in_silent_mode"
            app:iconSpaceReserved="false" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/_pref_key_notifications_vibrate"
            android:summaryOff="@string/notifications_vibrate_summary_off"
            android:summaryOn="@string/notifications_vibrate_summary_on"
            android:switchTextOff="@string/off"
            android:switchTextOn="@string/on"
            android:title="@string/pref_title_vibrate"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_cat_title_quiet_hours"
        app:iconSpaceReserved="false">

        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/_pref_key_notifications_time_range"
            android:summaryOff="@string/notifications_time_range_summary_off"
            android:summaryOn="@string/notifications_time_range_summary_on"
            android:switchTextOff="@string/off"
            android:switchTextOn="@string/on"
            android:title="@string/notifications_time_range"
            app:iconSpaceReserved="false" />

        <com.almothafar.simplebatterynotifier.ui.preference.TimePickerPreference
            android:dependency="@string/_pref_key_notifications_time_range"
            android:defaultValue="@string/_pref_value_notifications_time_range_start"
            android:key="@string/_pref_key_notifications_time_range_start"
            android:title="@string/notifications_time_range_start"
            app:iconSpaceReserved="false" />

        <com.almothafar.simplebatterynotifier.ui.preference.TimePickerPreference
            android:dependency="@string/_pref_key_notifications_time_range"
            android:defaultValue="@string/_pref_value_notifications_time_range_end"
            android:key="@string/_pref_key_notifications_time_range_end"
            android:title="@string/notifications_time_range_end"
            app:iconSpaceReserved="false" />

        <!-- Moved next to the quiet-hours window it overrides (#112); previously sat under the
             Critical category on another screen. Greyed out while quiet hours are off, when it
             has no effect (the stored value and alert logic are untouched by the dependency). -->
        <SwitchPreference
            android:defaultValue="true"
            android:dependency="@string/_pref_key_notifications_time_range"
            android:key="@string/_pref_key_critical_ignore_quiet_hours"
            android:summaryOff="@string/critical_ignore_quiet_hours_summary_off"
            android:summaryOn="@string/critical_ignore_quiet_hours_summary_on"
            android:switchTextOff="@string/off"
            android:switchTextOn="@string/on"
            android:title="@string/critical_ignore_quiet_hours"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

</PreferenceScreen>
